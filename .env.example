# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# --- Model provider ---
LLM_PROVIDER=mock                 # anthropic (Claude, needs ANTHROPIC_API_KEY) | openai-compatible | mock (offline, no key needed)
ANTHROPIC_API_KEY=
LLM_MODEL_REASONING=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
LLM_COST_INPUT_PER_MTOK=0         # price per million input tokens, for the cost estimate only
LLM_COST_OUTPUT_PER_MTOK=0
MOCK_LATENCY_MS=700               # delay per offline model call so a run can be watched; 0 = instant

# --- Bounded autonomy ---
RUN_MAX_ATTEMPTS=3
RUN_MAX_STEPS=25
LLM_CALL_TIMEOUT_MS=60000
RUN_TIMEOUT_MS=600000
RUN_TOKEN_BUDGET=400000
LLM_CONCURRENCY=4
LLM_CACHE=on

# --- Education rules ---
RISK_THRESHOLD=40
PLAN_MAX_HOURS_PER_WEEK=4

# --- School database (Neon Postgres) and sign-in ---
DATABASE_URL=                     # Neon connection string; empty = in-process Postgres seeded with the demo school
DEMO_PASSWORD=                    # shared password of the demo learners, teachers and principal (default thuso-demo-2026)
ADMIN_PASSWORD=                   # 12+ characters; the admin account is only created when this is set

# --- Delivery ---
DELIVERY_MODE=sandbox             # sandbox | redirect | live
DEMO_RECIPIENT=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=                        # e.g. Thuso <you@yourdomain>; must be allowed by your SMTP server
